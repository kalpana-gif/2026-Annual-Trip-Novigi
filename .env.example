# Server-only secret. Use a pooled Postgres URL from Neon or Supabase.
# Copy to .env.local, set your connection, then run npm run chat:setup.
# Add DATABASE_URL in Vercel or Netlify environment settings as well.
# Do not prefix this variable with VITE_ or put the real value in Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: development SQLite location when DATABASE_URL is not set.
# CHAT_DEV_DB_PATH=.data/trip-chat.sqlite
